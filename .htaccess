# cPanel Phusion Passenger & LiteSpeed WebSocket Rewrite Configuration
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Proxy raw WebSocket upgrade requests for Socket.IO on LiteSpeed
  RewriteCond %{HTTP:Upgrade} =websocket [NC]
  RewriteRule ^(.*)socket.io/(.*) ws://127.0.0.1:3001/socket.io/$2 [P,L]
</IfModule>
